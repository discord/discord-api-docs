{
	"name": "discord-api-docs-tools",
	"version": "1.1.1",
	"description": "Documentation for using Discord's Developer Platform",
	"main": "index.js",
	"type": "module",
	"directories": {
		"doc": "docs"
	},
	"engines": {
		"node": ">= 20.11.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/discord/discord-api-docs.git"
	},
	"author": "Discord for Developers",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/discord/discord-api-docs/issues"
	},
	"homepage": "https://github.com/discord/discord-api-docs#readme",
	"scripts": {
		"build": "tsc",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test:build": "tsx checkBuild.ts",
		"test:tables": "git ls-files .. | grep -E '.mdx?$' | xargs markdown-table-formatter --check",
		"fix:tables": "git ls-files .. | grep -E '.mdx?$' | xargs markdown-table-formatter",
		"decorate:docs": "node ./doxygen/generate-social-sdk-mapping.js && node ./doxygen/decorate-social-sdk-references.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mdx-js/mdx": "^3.0.1",
		"@types/node": "^26.5.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.1.3",
		"execa": "^10.0.1",
		"markdown-table-formatter": "^1.7.0",
		"mdast-util-from-markdown": "^2.0.1",
		"mdast-util-to-markdown": "^2.1.0",
		"prettier": "^3.2.5",
		"tsx": "^4.22.4",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.65.0"
	},
	"dependencies": {
		"xml2js": "^0.6.2"
	}
}
